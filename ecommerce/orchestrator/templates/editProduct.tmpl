{{template "header.tmpl" .}}
<h2>Edit Product</h2>

<form action="/app/product/{{.Product.Code}}/edit" method="POST">
    <label for="code">Code:</label><br>
    <span id="code">{{.Product.Code}}</span>
    <input type="hidden" name="code" value="{{.Product.Code}}"><br><br>

    <label for="name">Name:</label><br>
    <input type="text" id="name" name="name" value="{{.Product.Name}}" required><br><br>

    <label for="size">Size:</label><br>
    <select id="size" name="size" required>
        <option value="">-- Select size --</option>
        {{range .Sizes}}
            <option value="{{.}}" {{if eq . $.Product.Size}}selected{{end}}>{{.}}</option>
        {{end}}
    </select><br><br>

    <label for="color">Color:</label><br>
    <input type="text" id="color" name="color" value="{{.Product.Color}}" required><br><br>

    <label for="description">Description:</label><br>
    <textarea id="description" name="description" required>{{.Product.Description}}</textarea><br><br>

    <label for="stock">Availability (stock):</label><br>
    <input type="number" id="stock" name="stock" min="0" value="{{.Product.Stock}}" required><br><br>

    <label for="price">Price (€):</label><br>
    <input type="number" step="0.01" id="price" min="0" name="price" value="{{.Product.Price}}" required><br><br>

    <button type="submit">Update Product</button>
    <button type="button" onclick="if(confirm('Are you sure you want to cancel changes?')) { window.location.href='/app/product/'; }">Cancel</button>
</form>

{{template "footer.tmpl" .}}
