{{template "header.tmpl" .}}
<h2>Add New Product</h2>

<form action="/app/product/new" method="POST">
    <label for="code">Code:</label><br>
    <input type="text" id="code" name="code" required><br><br>

    <label for="name">Name:</label><br>
    <input type="text" id="name" name="name" required><br><br>

    <label for="size">Size:</label><br>
    <select id="size" name="size" required>
        <option value="">-- Select size --</option>
        {{range .Sizes}}
            <option value="{{.}}">{{.}}</option>
        {{end}}
    </select><br><br>

    <label for="color">Color:</label><br>
    <input type="text" id="color" name="color" required><br><br>

    <label for="description">Description:</label><br>
    <textarea id="description" name="description" required></textarea><br><br>

    <label for="stock">Availability (stock):</label><br>
    <input type="number" id="stock" name="stock" min="0" required><br><br>

    <label for="price">Price (€):</label><br>
    <input type="number" step="0.01" id="price" name="price" min="0" required><br><br>

    <button type="submit">Create Product</button>
</form>

{{template "footer.tmpl" .}}
