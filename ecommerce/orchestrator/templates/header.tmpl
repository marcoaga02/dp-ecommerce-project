{{define "header.tmpl"}}
<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{{.Title}}</title>
    <style>
        .error {
            color: red;
            margin-bottom: 10px;
        }

        .flash {
            color: green;
            margin-bottom: 10px;
        }

        .user-info {
            margin-left: 10px;
            font-size: 0.9em;
        }

        .user-info div {
            margin: 2px 0;
        }
    </style>
</head>

<body>
    <header style="background:#333;color:#fff;padding:10px 20px;">
        <h1 style="display:inline-block;margin:0;font-size:1.5em;">Ecommerce</h1>
        <nav style="float:right;">
            {{if .IsLoggedIn}}
            <span style="margin-right:15px;">Hello {{.Username}}</span>
            <a href="/app/" style="color:#fff;text-decoration:none;margin-left:10px;">Home</a>
            <a href="/app/user/profile" style="color:#fff;text-decoration:none;margin-left:10px;">Profile</a>
            <a href="/app/user/password" style="color:#fff;text-decoration:none;margin-left:10px;">Change Password</a>
            <a href="/app/user/logout" style="color:#fff;text-decoration:none;margin-left:10px;">Logout</a>
            {{else}}
            <a href="/login" style="color:#fff;text-decoration:none;margin-left:10px;">Login</a>
            <a href="/register" style="color:#fff;text-decoration:none;margin-left:10px;">Register</a>
            {{end}}
        </nav>
    </header>

    <main>
        {{if .Flash}}
        <div class="flash">{{.Flash}}</div>
        {{end}}
        {{if .Error}}
        <div class="error">{{.Error}}</div>
        {{end}}
        {{end}}