{{template "header.tmpl" .}}
<h2>Manage Users</h2>

<table border="1" cellpadding="5" cellspacing="0">
	<thead>
		<tr>
			<th>Username</th>
			<th>Email</th>
			<th>Phone</th>
			<th>Role</th>
			<th>Action</th>
		</tr>
	</thead>
	<tbody>
		{{range .Users}}
		<tr>
			<td>{{.Username}}</td>
			<td>{{.Email}}</td>
			<td>{{.Phone}}</td>
			<td>
				<form method="POST" action="/app/admin/users/{{.Username}}/role">
					<input type="hidden" name="_method" value="PATCH">
					<select name="role">
						<option value="client" {{if eq .Role "client" }}selected{{end}}>Client</option>
						<option value="administrator" {{if eq .Role "administrator" }}selected{{end}}>Administrator</option>
					</select>
			</td>
			<td>
				<button type="submit">Save</button>
				</form>
			</td>
		</tr>
		{{end}}
	</tbody>
</table>

<script>
	document.querySelectorAll('form select[name="role"]').forEach(select => {
		const saveBtn = select.closest('form').querySelector('button[type="submit"]');
		saveBtn.style.display = 'none';

		const originalValue = select.value;

		select.addEventListener('change', () => {
			if (select.value !== originalValue) {
				saveBtn.style.display = 'inline-block';
			} else {
				saveBtn.style.display = 'none';
			}
		});
	});
</script>

{{template "footer.tmpl" .}}